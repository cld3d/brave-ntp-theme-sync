[Unit]
Description=Sync Omarchy wallpaper to Brave NTP background
After=wayland-session@hyprland.desktop.target
BindsTo=wayland-session@hyprland.desktop.target

[Service]
Type=simple
ExecStart=%h/.local/bin/omarchy-brave-wallpaper-watch
Restart=on-failure
RestartSec=5

[Install]
WantedBy=wayland-session@hyprland.desktop.target
